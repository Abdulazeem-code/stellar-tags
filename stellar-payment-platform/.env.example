# ---------------------------------------------------------------------------
# Stellar Payment Platform — environment variables
# Copy this file to `.env` and fill in your own values.
#   cp .env.example .env
# ---------------------------------------------------------------------------

# PostgreSQL connection string used by Prisma.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
# Optional pool tuning: append &connection_limit=10&pool_timeout=5
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/stellar_tags?schema=public"

# Port the API server listens on (defaults to 5000).
# PORT=5000

# Horizon listener network: "testnet" (default) or "public".
# Selects the public Horizon endpoint; HORIZON_BASE overrides it entirely.
# HORIZON_NETWORK=testnet

# --- Horizon polling (backoff + jitter) --------------------------------------
# The listener schedules every Horizon request with an exponential-backoff
# policy rather than a fixed interval, so an unhealthy Horizon or an empty
# federation table slows the poll down instead of hammering it. All of these
# are optional.

# Base delay between poll cycles. Also the healthy steady-state interval:
# with zero failures the loop never waits longer than this.
# Default: 60000
# POLL_INTERVAL_MS=60000

# Ceiling for the exponential backoff curve while Horizon is unhealthy.
# Default: 900000 (15 minutes)
# POLL_MAX_INTERVAL_MS=900000

# Consecutive poll cycles that return no accounts before the interval
# starts stretching. Default: 3
# POLL_EMPTY_THRESHOLD=3

# Jitter strategy: "equal" (default, 50-100% of the delay), "full" (0-100%),
# or "none" (no jitter, not recommended for more than one instance).
# Default: equal
# HORIZON_POLL_JITTER=equal

# Timeout for the lightweight Horizon reachability probe. Default: 5000
# HORIZON_HEALTH_TIMEOUT_MS=5000

# Base delay before reconnecting a dropped SSE stream, and its ceiling.
# Default: 5000 / 300000
# STREAM_RECONNECT_BASE_MS=5000
# STREAM_RECONNECT_MAX_MS=300000

# --- Circuit breaker (Horizon) -----------------------------------------------
# Consecutive request volume / timeout before the breaker trips, and how long
# it stays open before probing for recovery.
# Default: 5 / 10000 / 30000
# CB_THRESHOLD=5
# CB_TIMEOUT_MS=10000
# CB_RESET_TIMEOUT_MS=30000

# Redis connection string for rate limiting and the BullMQ webhook worker.
# The webhook worker defaults to redis://127.0.0.1:6379 if not provided.
# REDIS_URL="redis://localhost:6379"

# --- Logging (rotating files) -------------------------------------------------
# Directory the rotating log files are written to.
# Defaults to `stellar-payment-platform/logs`.
# LOG_DIR="./logs"

# Minimum level to record: error | warn | info | http | verbose | debug | silly.
# Defaults to "info" in production and "debug" everywhere else.
# LOG_LEVEL=info

# Rotate the active log file once it grows past this size.
# LOG_MAX_SIZE=20m

# How much history to keep. Accepts a count ("30") or an age ("14d").
# LOG_MAX_FILES=14d

# Port for Prometheus metrics (if running on separate port)
# Leave unset to serve /metrics on the main app port
# METRICS_PORT=9090
# --- Error reporting (Sentry) --------------------------------------------------
# When set, unhandled errors (including 5xx Express errors, uncaught exceptions
# and unhandled promise rejections) are reported to this Sentry project.
# Left unset, Sentry is never initialized (e.g. local dev, tests).
# SENTRY_DSN="https://examplePublicKey@o0.ingest.sentry.io/0"

# --- Startup migration check --------------------------------------------------
# Behaviour when `prisma migrate status` finds the database out of sync:
#   "strict" -> log an error and exit (non-zero) before the server binds a port
#   "warn"   -> log a warning and keep booting (default)
#   "off"    -> skip the startup check entirely
# MIGRATION_POLICY=warn

# --- Admin API Key -------------------------------------------------------------
# Key used to authenticate with protected admin endpoints (e.g., blocking addresses)
ADMIN_API_KEY="your-secure-admin-api-key-here"

# --- CORS ------------------------------------------------------------------
# Extra origins allowed to call the API, beyond the built-in localhost/vercel
# defaults. Accepts a single origin or a comma-separated list.
# CORS_ALLOWED_ORIGINS="https://example.com,https://staging.example.com"
# VITE_API_BASE="https://api.yourdomain.com"

# --- JWT (RS256) --------------------------------------------------------------
# RSA key pair for signing and verifying JWTs.
# Generate with:
#   openssl genrsa -out private.pem 2048
#   openssl rsa -in private.pem -pubout -out public.pem
# Then paste the file contents below, replacing literal newlines with \n,
# or keep multi-line PEM values inside double quotes.
#
# JWT_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
# JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
#
# Token lifetime (default: 1h). Accepts ms/zeit-ms format or seconds.
# JWT_EXPIRY="1h"
