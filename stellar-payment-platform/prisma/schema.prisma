// Prisma schema for the Stellar Payment Platform.
// Migrated from a raw SQLite database to PostgreSQL for higher concurrency.
//
// The DATABASE_URL is read from the environment (see .env.example):
//   DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public"

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["metrics"]
}

// Federation registry mapping a human-readable username (e.g. "lekan*localhost")
// to its Stellar address. Maps to the legacy "username_registry" table so the
// data shape is preserved across the SQLite -> PostgreSQL migration.
model User {
  username  String    @id
  address   String    @unique
  memoType  String?   @map("memo_type")
  memo      String?
  createdAt DateTime  @default(now()) @map("created_at")
  flaggedAt DateTime? @map("flagged_at")
  deletedAt DateTime? @map("deleted_at")
  webhooks  Webhook[] // <-- add this line

  @@index([username])
  @@map("username_registry")
}

// Webhook registrations: merchants/users register a URL that receives POST
// notifications whenever a payment is successfully routed to one of their
// registered Stellar addresses.
model Webhook {
  id           String    @id @default(uuid())
  username     String
  user         User      @relation(fields: [username], references: [username], onDelete: Cascade)
  url          String
  secret       String // HMAC-SHA256 signing secret for payload verification
  createdAt    DateTime  @default(now()) @map("created_at")
  lastSentAt   DateTime? @map("last_sent_at")
  failingSince DateTime? @map("failing_since")

  @@unique([username, url])
  @@index([username])
  @@index([lastSentAt])
  @@map("webhooks")
}

// Dead-letter queue: holds webhook delivery attempts that have permanently
// failed (exhausted all retries).  Admin endpoints can list and manually
// replay individual entries so no critical event is lost.
model WebhookDLQ {
  id              String    @id @default(uuid())
  webhookId       String    @map("webhook_id")
  webhookUrl      String    @map("webhook_url")
  webhookSecret   String    @map("webhook_secret")
  username        String
  eventType       String    @map("event_type")
  eventPayload    String    @map("event_payload")
  failureReason   String    @map("failure_reason")
  deliveryAttempts Int      @default(0) @map("delivery_attempts")
  movedAt         DateTime  @default(now()) @map("moved_at")
  replayed        Boolean   @default(false)
  replayedAt      DateTime? @map("replayed_at")

  @@index([username])
  @@index([webhookId])
  @@index([movedAt])
  @@map("webhook_dlq")
}
