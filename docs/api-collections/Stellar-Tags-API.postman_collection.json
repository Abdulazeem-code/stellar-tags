                    "type": "text",
                    "description": "The G... address that signed."
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"tag\": \"{{tag}}\",\n  \"amount\": \"25\",\n  \"asset\": \"XLM\",\n  \"memo\": \"invoice-{{$timestamp}}\",\n  \"description\": \"Order #42\"\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                },
                "url": {
                  "raw": "{{apiUrl}}/payment-requests",
                  "host": [
                    "{{apiUrl}}"
                  ],
                  "path": [
                    "payment-requests"
                  ]
                }
              },
              "status": "Created",
              "code": 201,
              "_postman_previewlanguage": "json",
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\n  \"ok\": true,\n  \"data\": {\n    \"id\": \"2c80a413-18d7-5a51-990e-449b21996106\",\n    \"tag\": \"alice*localhost\",\n    \"destination\": \"GDQNY3PBOJOKYZSRMK2S7LHHGWZIUISD4QORETLMXEWXBI7KFZZMKTL3\",\n    \"amount\": \"25\",\n    \"asset\": \"XLM\",\n    \"memoType\": \"text\",\n    \"memo\": \"invoice-42\",\n    \"description\": \"Order #42\",\n    \"status\": \"pending\",\n    \"expiresAt\": \"2026-11-25T12:00:00.000Z\",\n    \"paidAt\": null,\n    \"transactionHash\": null,\n    \"createdAt\": \"2026-11-24T12:00:00.000Z\"\n  },\n  \"link\": \"https://localhost:5000/pay/alice?amount=25&memo=invoice-42&memoType=text&requestId=2c80a413-18d7-5a51-990e-449b21996106\",\n  \"sep7\": \"web+stellar:pay?destination=GDQNY3PBOJOKYZSRMK2S7LHHGWZIUISD4QORETLMXEWXBI7KFZZMKTL3&amount=25&memo=invoice-42&memo_type=text\"\n}"
