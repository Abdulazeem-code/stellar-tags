    {
      "name": "Payment Requests",
      "description": "One-off invoices for a tag. Create and cancel need a signature of \"payment-request:<tag>\" (see docs/api-reference.md#payment-requests). The read-only requests work against the seed data from `npm run db:seed`: `paymentRequestId` defaults to the first seeded request. Webhook events sent for payment requests: payment_request.paid, payment_request.expired, payment_request.cancelled.",
      "item": [
        {
          "name": "Create Payment Request",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{$guid}}",
                "type": "text",
                "description": "Required. Reuse the same key to safely retry."
              },
              {
                "key": "X-Stellar-Signature",
                "value": "{{stellarSignature}}",
                "type": "text",
                "description": "Base64 SEP-53 signature of \"payment-request:<tag>\" made with the tag's account key."
              },
              {
                "key": "X-Stellar-Signer",
                "value": "{{stellarSigner}}",
                "type": "text",
                "description": "The G... address that signed."
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tag\": \"{{tag}}\",\n  \"amount\": \"25\",\n  \"asset\": \"XLM\",\n  \"memo\": \"invoice-{{$timestamp}}\",\n  \"description\": \"Order #42\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{apiUrl}}/payment-requests",
              "host": [
                "{{apiUrl}}"
              ],
              "path": [
                "payment-requests"
              ]
            },
            "description": "Creates a pending payment request. Fill the `tag`, `stellarSignature` and `stellarSigner` collection variables first. Saves the new id to `paymentRequestId`."
          },
          "response": [
            {
              "name": "201 Created",
              "originalRequest": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json",
                    "type": "text"
                  },
                  {
