# Platform API (federation, lookup, register).
VITE_API_BASE=https://stellar-tags.onrender.com
# Domain part of tags, as in name*domain.
VITE_FEDERATION_DOMAIN=localhost
# testnet or mainnet.
VITE_NETWORK=testnet
# Needed for the WalletConnect option. Create one at https://cloud.reown.com
VITE_WALLETCONNECT_PROJECT_ID=
# Contact email Trezor Connect shows to the user. Defaults to support@<host>.
VITE_TREZOR_EMAIL=
